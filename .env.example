# Premku.com API
PREMKU_API_KEY=YOUR_KEY_HERE
PREMKU_BASE_URL=https://premku.com/api

# WhatsApp bot
BOT_NAME=Premku Bot
PREFIX=/
# Daftar nomor yang boleh pakai bot, pisahkan dengan koma. Kosongkan untuk semua orang.
ALLOWED_NUMBERS=

# Session
SESSION_DIR=./session

# Database SQLite lokal (Prisma). Path relatif ke folder prisma/.
DATABASE_URL=file:./dev.db

# Polling status pembayaran (ms). 0 = pakai nilai default 5000.
POLL_INTERVAL_MS=5000

# Timeout tunggu pembayaran (detik). 0 = pakai expired_in dari API.
PAY_TIMEOUT_SECONDS=0
